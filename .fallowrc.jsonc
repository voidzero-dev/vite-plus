{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.33.1/schema.json",
  "entry": [
    // Tests use vite-plus/test and are run by the root Vite config.
    "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
    ".github/scripts/__tests__/*.mjs",
    // Standalone scripts also run outside package.json scripts.
    "bench/*.ts",
    "ecosystem-ci/*.ts",
  ],
  "ignorePatterns": [
    // Fixture projects and templates are inputs to other programs.
    "crates/vp_cli_snapshots/tests/cli_snapshots/fixtures/**",
    "packages/cli/src/__tests__/fixtures/**",
    "packages/cli/templates/**",
    // Native bindings and task types are generated by the Rust build.
    "packages/*/binding/**",
    "packages/cli/src/run-config.ts",
  ],
  "workspaces": {
    // The documentation site has its own pnpm workspace.
    "patterns": ["docs"],
  },
}

{
  "name": "vite-plus-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "node .vitepress/scripts/copy-installers.mjs && vp run build:site",
    "build:cloudflare": "node .vitepress/scripts/copy-installers.mjs && vitepress build && node .vitepress/scripts/prepare-cloudflare.mjs",
    "build:netlify": "node .vitepress/scripts/copy-installers.mjs && vitepress build",
    "deploy:cloudflare": "cf deploy --prebuilt",
    "preview": "vitepress preview",
    "test:cloudflare": "node --test .vitepress/scripts/__tests__/prepare-cloudflare.mjs",
    "update-trusted-stack-stats": "node .vitepress/theme/data/fetch-trusted-stack-stats.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "mermaid": "^11.13.0",
    "reka-ui": "^2.7.0",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitepress-plugin-llms": "^1.12.2",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.5",
    "@voidzero-dev/vitepress-theme": "4.8.4",
    "cf": "1.0.0-beta.12",
    "oxc-minify": "^0.120.0",
    "tailwindcss": "^4.1.18",
    "vitepress": "2.0.0-alpha.17"
  },
  "packageManager": "pnpm@11.24.0"
}

+//! Synchronous embedder cache hook for the vpx prototype.
+//!
+//! The host owns persistence and build/runtime namespacing. The loader owns semantic
+//! identity and keeps configuration reads and CommonJS source-provenance checks live.
+
+use super::{
+    Arc, CompilerOptions, Module, Output, Path, PoisonError, loader_context, transform_options,
+};
+
+/// An Oxc result without an AST or decoded source map.
+///
+/// `module` means a format flip for a transform request, or ES module classification
+/// for a classification request. Classification-only CommonJS records have empty code
+/// and no map; they never authorize skipping the caller's live source/file comparison.
+#[derive(Clone, Debug)]
+pub struct CachedTransform {
+    pub code: String,
+    pub source_map: Option<String>,
+    pub module: bool,
+}
+
+impl CachedTransform {
+    pub(crate) fn from_output(output: &Output, module: bool) -> Self {
+        Self { code: output.code.clone(), source_map: output.source_map(), module }
+    }
+
+    pub(crate) fn classification() -> Self {
+        Self { code: String::new(), source_map: None, module: false }
+    }
+
+    pub(crate) fn into_output(self) -> Output {
+        Output { code: self.code, map: None, cached_map_json: self.source_map }
+    }
+}
+
+/// Optional host storage. Implementations must return `None` on invalid/unavailable
+/// records and must keep storage failures separate from compiler failures.
+///
+/// Hash every key part with its length, in order. Scope storage to the exact loader,
+/// compiler/helper build and runtime. There is no JS callback or asynchronous wait.
+pub trait TransformCache: Send + Sync {
+    fn get(&self, key: &[&[u8]]) -> Option<CachedTransform>;
+    fn put(&self, key: &[&[u8]], value: &CachedTransform);
+}
+
+/// Install a backend for this loader context. Captured contexts share it, while
+/// independent Node.js workers and off-thread ESM hooks initialize their own policy.
+pub fn set_transform_cache(cache: Option<Arc<dyn TransformCache>>) {
+    *loader_context().transform_cache.lock().unwrap_or_else(PoisonError::into_inner) = cache;
+}
+
+pub(crate) struct CacheRequest<'a> {
+    cache: Arc<dyn TransformCache>,
+    path: &'a Path,
+    source: &'a str,
+    options: String,
+    kind: &'static [u8],
+    is_es_module: [u8; 1],
+}
+
+impl<'a> CacheRequest<'a> {
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn new(
+        path: &'a Path,
+        source: &'a str,
+        compiler_options: Option<&CompilerOptions>,
+        module: Option<Module>,
+        top_level_await: bool,
+        is_es_module: bool,
+        helper: Option<&str>,
+        kind: &'static [u8],
+    ) -> Option<Self> {
+        let cache = loader_context()
+            .transform_cache
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .clone()?;
+        // Use the same complete normalized options as the transformer. Debug is a
+        // build-scoped encoding, not a cross-version public wire format. These options
+        // contain values, not resolver state, addresses or unordered alias maps.
+        let options =
+            format!("{:?}", transform_options(compiler_options, module, top_level_await, helper));
+        Some(Self { cache, path, source, options, kind, is_es_module: [u8::from(is_es_module)] })
+    }
+
+    fn key(&self) -> [&[u8]; 6] {
+        [
+            b"oxc-node-transform-v1",
+            self.kind,
+            self.path.as_os_str().as_encoded_bytes(),
+            self.source.as_bytes(),
+            self.options.as_bytes(),
+            &self.is_es_module,
+        ]
+    }
+
+    pub(crate) fn get(&self) -> Option<CachedTransform> {
+        self.cache.get(&self.key())
+    }
+
+    pub(crate) fn put(&self, value: &CachedTransform) {
+        self.cache.put(&self.key(), value);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::{
+        collections::HashMap,
+        sync::{
+            Mutex,
+            atomic::{AtomicUsize, Ordering},
+        },
+    };
+
+    use super::*;
+    use crate::{LoaderContext, LoaderContextGuard, oxc_transform};
+    use napi::Either;
+
+    #[derive(Default)]
+    struct MemoryCache {
+        entries: Mutex<HashMap<Vec<Vec<u8>>, CachedTransform>>,
+        hits: AtomicUsize,
+    }
+
+    impl TransformCache for MemoryCache {
+        fn get(&self, key: &[&[u8]]) -> Option<CachedTransform> {
+            let key: Vec<_> = key.iter().map(|part| part.to_vec()).collect();
+            let value = self.entries.lock().unwrap().get(&key).cloned();
+            if value.is_some() {
+                self.hits.fetch_add(1, Ordering::Relaxed);
+            }
+            value
+        }
+
+        fn put(&self, key: &[&[u8]], value: &CachedTransform) {
+            self.entries
+                .lock()
+                .unwrap()
+                .insert(key.iter().map(|part| part.to_vec()).collect(), value.clone());
+        }
+    }
+
+    fn transform(source: &str, options: &CompilerOptions, helper: &str) -> Output {
+        oxc_transform(
+            Path::new("cache.ts"),
+            &Either::<String, &[u8]>::B(source.as_bytes()),
+            Some(options),
+            Some(Module::Preserve),
+            false,
+            true,
+            Some(helper),
+            None,
+        )
+        .unwrap()
+        .0
+    }
+
+    #[test]
+    fn cached_transform_preserves_maps_and_invalidates_source_options_and_helpers() {
+        let _guard = LoaderContextGuard::enter(Arc::new(LoaderContext::default()));
+        let cache = Arc::new(MemoryCache::default());
+        set_transform_cache(Some(cache.clone()));
+        let source = "class Value { count: number = 1; } console.log(new Value().count);";
+        let mut options = CompilerOptions::default();
+        options.use_define_for_class_fields = Some(false);
+        let first = transform(source, &options, "helpers-a");
+        let cached = transform(source, &options, "helpers-a");
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+        assert_eq!(first.source(), cached.source());
+        assert_eq!(first.source_map(), cached.source_map());
+        let changed = transform(&source.replace("= 1", "= 2"), &options, "helpers-a");
+        assert_ne!(first.source(), changed.source());
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+        options.use_define_for_class_fields = Some(true);
+        let changed = transform(source, &options, "helpers-a");
+        assert_ne!(first.source(), changed.source());
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+        transform(source, &options, "helpers-b");
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+    }
+
+    #[test]
+    fn cache_policy_is_scoped_to_the_loader_context() {
+        let cache = Arc::new(MemoryCache::default());
+        let _outer = LoaderContextGuard::enter(Arc::new(LoaderContext::default()));
+        set_transform_cache(Some(cache.clone()));
+        let source = "console.log(1);";
+        let options = CompilerOptions::default();
+        transform(source, &options, "helpers");
+        {
+            let _inner = LoaderContextGuard::enter(Arc::new(LoaderContext::default()));
+            transform(source, &options, "helpers");
+            assert_eq!(cache.hits.load(Ordering::Relaxed), 0);
+        }
+        transform(source, &options, "helpers");
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+    }
+
+    #[test]
+    fn esm_format_flip_is_preserved_on_a_hit() {
+        let _guard = LoaderContextGuard::enter(Arc::new(LoaderContext::default()));
+        let cache = Arc::new(MemoryCache::default());
+        set_transform_cache(Some(cache.clone()));
+        let source = "export const value: number = 1;";
+        let run = || {
+            oxc_transform(
+                Path::new("cache.ts"),
+                &Either::<String, &[u8]>::B(source.as_bytes()),
+                None,
+                Some(Module::Preserve),
+                true,
+                false,
+                Some("helpers"),
+                None,
+            )
+            .unwrap()
+        };
+        let (first, first_module) = run();
+        let (cached, cached_module) = run();
+        assert!(first_module && cached_module);
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+        assert_eq!(first.source(), cached.source());
+        assert_eq!(first.source_map(), cached.source_map());
+    }
+
+    #[test]
+    fn cts_classification_hits_but_never_caches_a_module_syntax_error() {
+        let _guard = LoaderContextGuard::enter(Arc::new(LoaderContext::default()));
+        let cache = Arc::new(MemoryCache::default());
+        set_transform_cache(Some(cache.clone()));
+        let path = Path::new("cache.cts");
+        for _ in 0..2 {
+            assert!(
+                crate::reject_cts_module_syntax(path, Some("const value: number = 1;"), None)
+                    .unwrap()
+                    .is_none()
+            );
+        }
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+        for _ in 0..2 {
+            assert!(
+                crate::reject_cts_module_syntax(
+                    path,
+                    Some("export const value: number = 1;"),
+                    None
+                )
+                .is_err()
+            );
+        }
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+    }
+
+    #[test]
+    fn ambiguous_classification_reuses_esm_and_commonjs_results() {
+        use crate::{LoadFnOutput, TryAsStr, load_commonjs_esm};
+
+        let _guard = LoaderContextGuard::enter(Arc::new(LoaderContext::default()));
+        let cache = Arc::new(MemoryCache::default());
+        set_transform_cache(Some(cache.clone()));
+        let output =
+            LoadFnOutput { format: "commonjs".to_owned(), source: None, response_url: None };
+        let url = crate::path_to_file_url(&std::env::temp_dir().join("cache.ts").to_string_lossy());
+        for _ in 0..2 {
+            let result = load_commonjs_esm(
+                &url,
+                &output,
+                Some("export const value: number = 1;"),
+                None,
+                None,
+            )
+            .unwrap()
+            .unwrap();
+            assert_eq!(result.format, "module");
+            assert!(result.source.as_ref().unwrap().try_as_str().unwrap().contains("export"));
+        }
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 1);
+        for _ in 0..2 {
+            assert!(
+                load_commonjs_esm(&url, &output, Some("const value: number = 1;"), None, None)
+                    .unwrap()
+                    .is_none()
+            );
+        }
+        assert_eq!(cache.hits.load(Ordering::Relaxed), 2);
+    }
+
+    #[test]
+    fn a_classification_hit_still_checks_the_current_disk_source() {
+        use crate::{Either4, LoadFnOutput, TryAsStr, transform_output};
+
+        struct FileGuard(std::path::PathBuf);
+        impl Drop for FileGuard {
+            fn drop(&mut self) {
+                let _ = std::fs::remove_file(&self.0);
+            }
+        }
+
+        let _guard = LoaderContextGuard::enter(Arc::new(LoaderContext::default()));
+        let cache = Arc::new(MemoryCache::default());
+        set_transform_cache(Some(cache.clone()));
+        let file = FileGuard(
+            std::env::temp_dir().join(format!("oxc-cache-provenance-{}.ts", std::process::id())),
+        );
+        let url = crate::path_to_file_url(&file.0.to_string_lossy());
+        let source = "module.exports = 1;";
+        let output = || LoadFnOutput {
+            format: "commonjs".to_owned(),
+            source: Some(Either4::A(source.to_owned())),
+            response_url: None,
+        };
+        std::fs::write(&file.0, source).unwrap();
+        let first = transform_output(url.clone(), output(), None, None).unwrap();
+        assert!(matches!(first.source, Some(Either4::D(_))));
+        std::fs::write(&file.0, "module.exports = 2;").unwrap();
+        let next = transform_output(url, output(), None, None).unwrap();
+        assert!(cache.hits.load(Ordering::Relaxed) > 0);
+        assert!(next.source.as_ref().unwrap().try_as_str().unwrap().contains("= 1"));
+    }

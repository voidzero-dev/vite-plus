{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Boshen/renovate"],
  "description": "Skip lockfile artifact updates (npm and cargo): they fail in Renovate's clone because vite/ and rolldown/ are gitignored. The renovate-lockfiles workflow regenerates lockfiles on renovate/** pushes; gitIgnoredAuthors keeps Renovate managing branches with its commits. ignorePaths excludes test fixtures: their deps are test data, and the migration_monorepo_pnpm_overrides_dependency_selector fixture's multi-level pnpm override selector aborts the whole Renovate scan with ERR_PNPM_INVALID_SELECTOR.",
  "gitIgnoredAuthors": ["278573678+voidzero-guard[bot]@users.noreply.github.com"],
  "skipArtifactsUpdate": true,
  "ignorePaths": [
    "bench/fixtures/**",
    "crates/vp_cli_snapshots/tests/cli_snapshots/fixtures/**",
    "packages/cli/src/__tests__/fixtures/**",
    "oxc-node/**",
    "rolldown/**",
    "vite/**"
  ],
  "customManagers": [
    {
      "description": "Update the Nushell release used by CLI snapshot tests.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=nushell/nushell\\s+version: '(?<currentValue>[^']+)'"
      ],
      "depNameTemplate": "nushell/nushell",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Keep the exact setup-vp migration target current.",
      "customType": "regex",
      "managerFilePatterns": ["/^packages\\/cli\\/src\\/utils\\/constants\\.ts$/"],
      "matchStrings": ["export const SETUP_VP_VERSION = '(?<currentValue>[^']+)';"],
      "depNameTemplate": "voidzero-dev/setup-vp",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Update the cargo-xwin version used for Windows builds.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/actions/setup-xwin/action\\.yml$/"],
      "matchStrings": ["CARGO_XWIN_VERSION: '(?<currentValue>[^']+)'"],
      "depNameTemplate": "cargo-xwin",
      "datasourceTemplate": "crate"
    },
    {
      "description": "Update the Windows SDK release and its archive checksum together.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/actions/setup-xwin/action\\.yml$/"],
      "matchStrings": [
        "SYSROOT_VERSION: '(?<currentValue>\\d{4}-\\d{2}-\\d{2})'\\s+SYSROOT_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "trcrsired/windows-msvc-sysroot",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    }
  ],
  "packageRules": [
    {
      "description": "Manage the shared Node.js pin through .github/workflows/upgrade-deps.yml.",
      "matchFileNames": [".node-version"],
      "enabled": false
    },
    {
      "description": "Require review for Windows SDK and cargo-xwin updates.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/actions/setup-xwin/action.yml"],
      "matchPackageNames": ["cargo-xwin", "trcrsired/windows-msvc-sysroot"],
      "groupName": "Windows build toolchain",
      "automerge": false
    },
    {
      "description": "Ignore toolchain npm packages managed by .github/workflows/upgrade-deps.yml through upgrade-deps.ts and sync-remote. Official Vitest packages share the runner version; the independently versioned @vitest/browser-webdriverio remains enabled.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "rolldown",
        "/^oxc-.*/",
        "@oxc-node/*",
        "@oxc-project/*",
        "@oxlint/plugins",
        "@tsdown/css",
        "@tsdown/exe",
        "@vitejs/devtools",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/browser-preview",
        "@vitest/coverage-istanbul",
        "@vitest/coverage-v8",
        "@vitest/mocker",
        "@vitest/pretty-format",
        "@vitest/snapshot",
        "@vitest/spy",
        "@vitest/ui",
        "@vitest/utils",
        "@vitest/web-worker",
        "lightningcss",
        "lint-staged",
        "oxfmt",
        "oxlint",
        "oxlint-tsgolint",
        "tsdown",
        "vite",
        "vitest",
        "vitest-dev",
        "yuku-parser"
      ],
      "enabled": false
    },
    {
      "description": "Core's postcss and fsevents ranges follow the bundled Vite version through upgrade-deps.ts --sync-bundled-deps.",
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/core/package.json"],
      "matchPackageNames": ["postcss", "fsevents"],
      "matchDepTypes": ["dependencies", "optionalDependencies"],
      "enabled": false
    },
    {
      "description": "Core's peer dependency ranges are generated from the bundled upstream packages by packages/core/build.ts.",
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/core/package.json"],
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Ignore oxc crate updates synchronized with Rolldown by .github/workflows/upgrade-deps.yml.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^oxc([_-].*)?$/"],
      "enabled": false
    },
    {
      "description": "Ignore root catalog dependencies imported from rolldown/pnpm-workspace.yaml and vite/pnpm-workspace.yaml by sync-remote in .github/workflows/upgrade-deps.yml. Keep this list aligned with used upstream catalog entries; independent package.json dependencies remain enabled.",
      "matchManagers": ["npm"],
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchPackageNames": [
        "@emnapi/core",
        "@emnapi/runtime",
        "@napi-rs/cli",
        "@napi-rs/wasm-runtime",
        "@rolldown/pluginutils",
        "@types/node",
        "cac",
        "consola",
        "emnapi",
        "execa",
        "fresh-import",
        "glob",
        "pathe",
        "remeda",
        "rolldown-plugin-dts",
        "rollup",
        "semver",
        "signal-exit",
        "source-map",
        "typescript",
        "valibot",
        "yaml"
      ],
      "enabled": false
    },
    {
      "description": "Ignore root workspace crates used by vendored Rolldown or oxc-node crates and synchronized by .github/workflows/upgrade-deps.yml. Keep this list aligned with their registry dependencies, using package names for renamed crates; project-only crates, upstream development tools, and other manifests remain enabled.",
      "matchManagers": ["cargo"],
      "matchFileNames": ["Cargo.toml"],
      "matchPackageNames": [
        "anyhow",
        "append-only-vec",
        "arcstr",
        "async-channel",
        "async-scoped",
        "base-encode",
        "base64-simd",
        "bitflags",
        "blake3",
        "cow-utils",
        "criterion2",
        "dashmap",
        "derive_more",
        "dunce",
        "fast-glob",
        "flate2",
        "form_urlencoded",
        "futures",
        "glob",
        "globstar",
        "heck",
        "idna_adapter",
        "indexmap",
        "infer",
        "insta",
        "itertools",
        "itoa",
        "json-escape-simd",
        "json-strip-comments",
        "jsonschema",
        "memchr",
        "mimalloc-safe",
        "mime",
        "napi",
        "napi-build",
        "napi-derive",
        "nodejs-built-in-modules",
        "nom",
        "num-bigint",
        "num_cpus",
        "owo-colors",
        "parking_lot",
        "path-posix",
        "percent-encoding",
        "petgraph",
        "phf",
        "pnp",
        "rayon",
        "regex",
        "regress",
        "rolldown-ariadne",
        "rolldown-notify",
        "rolldown-notify-debouncer-full",
        "rustc-hash",
        "saphyr",
        "schemars",
        "self_cell",
        "serde",
        "serde_json",
        "simdutf8",
        "smallvec",
        "sugar_path",
        "supports-color",
        "terminal_size",
        "testing_macros",
        "tokio",
        "tracing",
        "tracing-chrome",
        "tracing-subscriber",
        "ts-rs",
        "typedmap",
        "url",
        "uuid",
        "vfs",
        "walkdir",
        "xxhash-rust"
      ],
      "enabled": false
    },
    {
      "description": "Ignore vite-task git dependency digest updates: every crate from that repository shares one revision, which the upgrade-deps workflow moves to the latest main commit. Match the git source, not crate names, so crates added upstream (pty_terminal_test, snapshot_test, vt_select) stay covered without editing a list here.",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["https://github.com/voidzero-dev/vite-task.git"],
      "enabled": false
    }
  ]
}

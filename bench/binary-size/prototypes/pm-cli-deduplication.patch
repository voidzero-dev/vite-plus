+    #[test]
+    fn version_rules_keep_release_and_prerelease_boundaries() {
+        #[pm_args]
+        #[derive(clap::Args)]
+        struct VersionArgs {
+            #[arg(long, not_supported(bun < "1.4"))]
+            release: bool,
+            #[arg(long, not_supported(bun < "1.4.0-beta.2"))]

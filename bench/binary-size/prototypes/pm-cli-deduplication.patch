+            ("1.4.0", None),
+            ("1.4.1", None),
+        ] {
+            let mut diagnostics = Diagnostics::default();
+            args.diagnose(&bun(version), &mut diagnostics);
+            assert_eq!(diagnostics.unsupported_options_error().as_deref(), messages, "{version}");
+        }
+    }

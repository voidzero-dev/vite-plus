diff --git a/crates/vt_materialized_artifact/tests/compression.rs b/crates/vt_materialized_artifact/tests/compression.rs
new file mode 100644
index 00000000..476c1cb7
--- /dev/null
+++ b/crates/vt_materialized_artifact/tests/compression.rs
@@ -0,0 +1,44 @@
+use std::fs;
+
+use vt_materialized_artifact::{Artifact, artifact};
+
+#[test]
+fn compressed_macro_preserves_content_and_cache_path() {
+    let original = include_bytes!(env!("CARGO_MANIFEST_PATH"));
+    let embedded = artifact!("manifest", "CARGO_MANIFEST_PATH");
+    let dir = tempfile::tempdir().unwrap();
+    let path = embedded.materialize().at(dir.path()).unwrap();
+    assert_eq!(fs::read(&path).unwrap(), original);
+    let expected = format!("manifest_{:x}", xxhash_rust::xxh3::xxh3_128(original));
+    assert_eq!(path.file_name().unwrap(), expected.as_str());
+    let modified = fs::metadata(&path).unwrap().modified().unwrap();
+    assert_eq!(embedded.materialize().at(dir.path()).unwrap(), path);
+    assert_eq!(fs::metadata(&path).unwrap().modified().unwrap(), modified);
+    assert_eq!(fs::read_dir(dir.path()).unwrap().count(), 1);
+}
+
+#[test]
+fn corrupt_compressed_data_is_not_published() {
+    let embedded = Artifact::__new_zstd("broken", b"not a zstd frame", "hash");
+    let dir = tempfile::tempdir().unwrap();
+    assert!(embedded.materialize().at(dir.path()).is_err());
+    assert_eq!(fs::read_dir(dir.path()).unwrap().count(), 0);
+}
+
+#[test]
+fn raw_and_compressed_content_materialize_identically() {
+    let bytes = b"payload payload payload payload payload payload";
+    let compressed = zstd::bulk::compress(bytes, 19).unwrap();
+    let compressed = Box::leak(compressed.into_boxed_slice());
+    let raw = Artifact::__new("raw", bytes, "hash");
+    let compressed = Artifact::__new_zstd("compressed", compressed, "hash");
+    let dir = tempfile::tempdir().unwrap();
+    let raw_path = raw.materialize().executable().at(dir.path()).unwrap();
+    let compressed_path = compressed.materialize().executable().at(dir.path()).unwrap();
+    assert_eq!(fs::read(raw_path).unwrap(), fs::read(&compressed_path).unwrap());
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        assert_eq!(fs::metadata(compressed_path).unwrap().permissions().mode() & 0o777, 0o755);
+    }
+}
